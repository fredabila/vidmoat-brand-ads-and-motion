# Vidmoat developer API key (https://developer.vidmoat.com/apps). Server-side only.
# A test key (vmk_test_…) builds real previews for free; renders return Vidmoat's sample file.
# A live key (vmk_live_…) renders real MP4s and uses your export allowance.
# Scopes needed: projects.read projects.write media.write render.read render.write stock.read
VIDMOAT_KEY=

# Claude writes the script. Without it, scripts are assembled from the page's own text.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Signs the per-video tokens. Set it so tokens survive a key rotation; defaults to a hash of VIDMOAT_KEY.
# APP_SECRET=

# Optional: require this code to make a video (a simple gate while the site is private).
# ACCESS_CODE=

# Per-visitor limits, per hour.
# VIDEOS_PER_HOUR=6
# RENDERS_PER_HOUR=6

# Set to 1 when the app runs behind one reverse proxy, so limits use the visitor's address.
# TRUST_PROXY=1
# PORT=3000
